window-rule {
  match app-id="com.gabm.satty"

  default-column-width { proportion 0.90; }
  default-window-height { proportion 0.90; }

  open-floating true
}

window-rule {
    match app-id="^com\\.mitchellh\\.ghostty$"

    background-effect {
        blur true
    }

}


blur {
    passes 3
    offset 1.5
    noise 0.02
    saturation 1.5
}
